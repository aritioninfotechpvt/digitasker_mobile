<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Handle Authorization Header for Laravel API
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1. Forward /api/* requests to Laravel backend (located in backend/public/)
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]

    # 2. React Router Client-Side Routing: fallback all non-file & non-directory requests to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
